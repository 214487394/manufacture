/* =========================================================
   语音识别
   ========================================================= */
function initRecog(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){
    toast('当前浏览器不支持语音识别，请用 Chrome/Edge 或直接打字');
    return null;
  }
  const r = new SR();
  r.lang = 'zh-CN';
  r.continuous = true;
  r.interimResults = true;
  r.maxAlternatives = 1;

  r.onresult = e => {
    let interim = '';
    for(let i=e.resultIndex; i<e.results.length; i++){
      const res = e.results[i];
      if(res.isFinal){
        pendingText += res[0].transcript;
        clearTimeout(pendingTimer);
        pendingTimer = setTimeout(flushPending, 2200);
      } else {
        interim += res[0].transcript;
      }
    }
    const el = $('#interim');
    if(interim){
      el.textContent = '识别中：' + interim;
      el.classList.add('live');
    } else if(pendingText){
      el.textContent = '待归纳：' + pendingText;
      el.classList.add('live');
    } else {
      el.textContent = '聆听中…';
      el.classList.remove('live');
    }
  };
  r.onerror = ev => {
    console.warn('语音错误', ev.error);
    if(ev.error === 'not-allowed') toast('请允许麦克风权限');
  };
  r.onend = ()=>{ if(recording){ try{ r.start(); }catch(_){} } };
  return r;
}

function flushPending(){
  const t = pendingText.trim();
  pendingText = '';
  const el = $('#interim');
  el.textContent = recording ? '聆听中…' : '已停止';
  el.classList.remove('live');
  if(t){
    addRecord(t);
    vibrate(20);
  }
}

$('#btnMic').addEventListener('click', ()=>{
  if(!recog) recog = initRecog();
  if(!recog) return;
  try{
    recog.start();
    recording = true;
    $('#btnMic').classList.add('on');
    $('#btnMic').textContent = '● 录音中…点击停止';
    $('#btnStop').disabled = false;
    $('#interim').textContent = '聆听中…';
    vibrate(30);
  }catch(e){ console.warn(e); }
});

$('#btnStop').addEventListener('click', ()=>{
  recording = false;
  clearTimeout(pendingTimer);
  flushPending();
  if(recog){ try{ recog.stop(); }catch(_){} }
  $('#btnMic').classList.remove('on');
  $('#btnMic').textContent = '🎤 点击开始口述';
  $('#btnStop').disabled = true;
  vibrate(30);
});

