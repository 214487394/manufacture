/* =========================================================
   报告生成
   ========================================================= */
function mdCell(s){ return String(s).replace(/\|/g,'\\|').replace(/\n/g,' '); }

function buildReport(){
  const recs = [...records].sort((a,b)=>a.time - b.time);
  const now = new Date();
  const L = [];

  L.push('# JK22402 中试生产记录报告');
  L.push('');
  L.push('| 项目 | 内容 |');
  L.push('|---|---|');
  L.push('| 项目编号 | JK22402 |');
  L.push('| 产品 / 规格 | 乙酰半胱氨酸片 600mg（理论片重 750mg） |');
  L.push('| 记录人 | ' + ($('#recorder').value.trim() || '＿＿＿') + ' |');
  L.push('| 报告生成 | ' + fmtFull(now) + ' |');
  L.push('| 记录条数 | ' + recs.length + ' 条 |');
  const batchSet = new Set(recs.map(r=>r.batch));
  if(batchSet.size) L.push('| 涉及批次 | ' + [...batchSet].join('、') + ' |');
  L.push('');

  // 一、全局时间轴（跨批次交错）
  L.push('## 一、全局时间轴（按事件发生时间排序）');
  L.push('');
  if(!recs.length){
    L.push('> 暂无记录。');
  } else {
    L.push('| 时间 | 批次 | 工序 | 类别 | 记录内容 |');
    L.push('|---|---|---|---|---|');
    recs.forEach(r=>{
      L.push(`| ${r.dateText} ${r.timeText} | ${r.batch} | ${r.step} | ${r.category} | ${mdCell(r.text)} |`);
    });
  }
  L.push('');

  // 二、批次内时间线
  L.push('## 二、各批次时间线');
  L.push('');
  const byBatch = {};
  recs.forEach(r=>{
    if(!byBatch[r.batch]) byBatch[r.batch] = [];
    byBatch[r.batch].push(r);
  });
  Object.keys(byBatch).forEach(b=>{
    L.push(`### ${b}`);
    L.push('');
    L.push('| 时间 | 工序 | 类别 | 记录内容 |');
    L.push('|---|---|---|---|');
    byBatch[b].forEach(r=>{
      L.push(`| ${r.timeText} | ${r.step} | ${r.category} | ${mdCell(r.text)} |`);
    });
    L.push('');
  });

  // 三、批次并行对比（时间分段）
  L.push('## 三、批次并行时间对比');
  L.push('');
  if(Object.keys(byBatch).length >= 2){
    // 收集所有时间点
    const allTimes = [...new Set(recs.map(r=>r.dateText + ' ' + r.timeText))].sort();
    const header = '| 时间 | ' + Object.keys(byBatch).join(' | ') + ' |';
    const sep = '|---|' + Object.keys(byBatch).map(()=>'---').join('|') + '|';
    L.push(header);
    L.push(sep);
    // 按30分钟粒度聚合
    const buckets = {};
    recs.forEach(r=>{
      const d = new Date(r.time);
      d.setMinutes(Math.floor(d.getMinutes()/30)*30, 0, 0);
      const key = fmtHM(d);
      if(!buckets[key]) buckets[key] = {};
      if(!buckets[key][r.batch]) buckets[key][r.batch] = [];
      buckets[key][r.batch].push(r.step);
    });
    Object.keys(buckets).sort().forEach(k=>{
      const row = [k];
      Object.keys(byBatch).forEach(b=>{
        const steps = buckets[k][b];
        row.push(steps ? [...new Set(steps)].join('、') : '');
      });
      L.push('| ' + row.join(' | ') + ' |');
    });
    L.push('');
  } else {
    L.push('（仅一个批次，无需并行对比）');
    L.push('');
  }

  // 四、偏差/异常
  const abn = recs.filter(r=>r.category === '偏差/异常');
  L.push('## 四、偏差 / 异常汇总');
  L.push('');
  if(!abn.length){
    L.push('本次记录未发现偏差或异常项。');
  } else {
    abn.forEach((r,i)=>{
      L.push(`${i+1}. **${r.timeText}｜${r.batch}｜${r.step}**：${r.text}`);
      L.push(`   - 建议：按《偏差处理管理规程》评估影响，必要时填写偏差处理单并取样确认。`);
    });
  }
  L.push('');

  // 五、参数符合性
  const withParams = recs.filter(r=>r.params.length);
  L.push('## 五、关键工艺参数符合性检查');
  L.push('');
  if(!withParams.length){
    L.push('本次记录未提取到工艺参数。');
  } else {
    L.push('| 时间 | 批次 | 工序 | 参数 | 记录值 | 方案范围 | 判定 |');
    L.push('|---|---|---|---|---|---|---|');
    let over = 0;
    withParams.forEach(r=>{
      r.params.forEach(p=>{
        if(!p.ok) over++;
        L.push(`| ${r.timeText} | ${r.batch} | ${r.step} | ${p.key} | ${p.value}${p.unit} | ${p.range} | ${p.ok?'符合':'⚠超范围'} |`);
      });
    });
    L.push('');
    L.push(over ? `> ⚠ 共 **${over}** 项参数超出方案设定范围，请核实是否需启动偏差处理。`
                : '> 所有已记录参数均在方案设定范围内。');
  }
  L.push('');

  // 六、取样/检测
  const smp = recs.filter(r=>r.category === '取样/检测');
  L.push('## 六、取样 / 检测记录');
  L.push('');
  if(!smp.length){
    L.push('本次记录未包含取样或检测信息。');
  } else {
    smp.forEach(r=>L.push(`- ${r.timeText}｜${r.batch}｜${r.step}：${r.text}`));
  }
  L.push('');

  // 七、工序覆盖
  L.push('## 七、工序记录覆盖检查');
  L.push('');
  L.push('| 工序 | 记录条数 |');
  L.push('|---|---|');
  STEPS.forEach(s=>{
    const n = recs.filter(r=>r.step === s.name).length;
    L.push(`| ${s.name} | ${n || '—'} |`);
  });
  L.push('');

  // 八、原始记录
  L.push('## 八、原始口述记录（按时间）');
  L.push('');
  if(!recs.length) L.push('（无）');
  else recs.forEach(r=>L.push(`- ${fmtFull(r.time)}　【${r.batch}】【${r.step}】${r.text}`));
  L.push('');
  L.push('---');
  L.push('');
  L.push('> 本报告由语音速记自动归纳生成，作为现场记录整理底稿；正式数据以批生产记录、批检验记录及偏差处理单为准。');

  return L.join('\n');
}

